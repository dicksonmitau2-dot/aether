<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AetherMind" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorPrimaryVariant">@color/bg_dark</item>
        <item name="colorOnPrimary">@color/bg_dark</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/green</item>
        <item name="colorOnSecondary">@color/bg_dark</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_panel</item>
        <item name="colorOnSurface">@color/white</item>

        <!-- Status bar and navigation bar -->
        <item name="android:statusBarColor">@color/bg_panel</item>
        <item name="android:navigationBarColor">@color/bg_panel</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/gray</item>

        <!-- EditText cursor -->
        <item name="colorControlActivated">@color/cyan</item>
        <item name="colorControlHighlight">@color/bg_input</item>

        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Widget.AetherMind.SendButton" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="backgroundTint">@color/cyan</item>
        <item name="elevation">0dp</item>
        <item name="hoveredElevation">0dp</item>
        <item name="pressedElevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="rippleColor">@color/bg_input</item>
    </style>
</resources>
